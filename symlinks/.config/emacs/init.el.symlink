;;; init.el --- Emacs configuration -*- lexical-binding: t; -*-

;;(setq debug-on-error t)

;;; Packages
;; use-package is built in (Emacs 29+); package.el initializes itself before init.
(require 'package)
(add-to-list 'package-archives '("melpa" . "https://melpa.org/packages/") t)
;; Install missing packages automatically; built-ins opt out with `:ensure nil'.
(setq use-package-always-ensure t)

;; Import PATH and friends from the login shell (reads ~/.zprofile for Homebrew).
(use-package exec-path-from-shell
  :if (or (daemonp) (memq window-system '(mac ns)))
  :custom
  (exec-path-from-shell-arguments '("-l"))
  (exec-path-from-shell-check-startup-files nil)
  (exec-path-from-shell-variables '("PATH" "MANPATH" "SHELL" "GOPATH" "GOBIN" "PYENV_ROOT"))
  :config
  (exec-path-from-shell-initialize))

;; Settings made through M-x customize live in their own file.
(setq custom-file "~/dotfiles/config/emacs/custom.el")
(load custom-file 'noerror)

;;; Modules
(defconst rr/emacs-config-dir "~/dotfiles/config/emacs/"
  "Directory holding the modules loaded below.")
(dolist (module '("config-theme" "config-completion" "config-orgmode" "config-prog"))
  (load (expand-file-name module rr/emacs-config-dir)))

;;; General behavior
(set-language-environment "UTF-8")
(setq visible-bell t
      use-dialog-box nil               ; macOS dialogs can't be dismissed from the keyboard
      use-short-answers t              ; y/n instead of yes/no
      sentence-end-double-space nil
      send-mail-function #'smtpmail-send-it
      ispell-program-name "ispell")
(setq-default fill-column 100
              tab-width 4)
(add-hook 'text-mode-hook #'auto-fill-mode)
(electric-pair-mode 1)
(display-time-mode 1)
(mouse-avoidance-mode 'cat-and-mouse)

;; Remember recent files, cursor positions, and reload files changed on disk.
(recentf-mode 1)
(save-place-mode 1)
(global-auto-revert-mode 1)
(setq global-auto-revert-non-file-buffers t) ; e.g. Dired

(when (display-graphic-p)
  (pixel-scroll-precision-mode 1))

;; Keep backup, auto-save, and lock files out of working directories.
(let ((backups   (locate-user-emacs-file "backups/"))
      (auto-save (locate-user-emacs-file "auto-save/")))
  (make-directory auto-save t)
  (setq backup-directory-alist `(("." . ,backups))
        auto-save-file-name-transforms `((".*" ,auto-save t))
        lock-file-name-transforms `((".*" ,auto-save t))))

(when (eq system-type 'darwin)
  (setq locate-command "mdfind"))  ; Spotlight

;; Use GNU ls (coreutils) so Dired gets --dired support.
(when-let* ((gls (executable-find "gls")))
  (setq insert-directory-program gls
        dired-use-ls-dired t
        dired-listing-switches "-alh"))
(setq eshell-ls-initial-args '("-lh"))

;;; Emacs server, with emacsclient as $EDITOR for child processes
;; A daemon starts its own server after init. A regular Emacs starts one
;; only if nothing else (e.g. the brew services daemon) already owns the socket.
(use-package server
  :ensure nil
  :unless (daemonp)
  :config
  (unless (server-running-p)
    (server-start)))

(use-package with-editor
  :bind (([remap async-shell-command] . with-editor-async-shell-command)
         ([remap shell-command]       . with-editor-shell-command))
  :hook ((shell-mode term-mode eshell-mode) . with-editor-export-editor))

;;; Keys
;; Use C-x C-m instead of M-x, and C-w to kill backwards by word
;; https://sites.google.com/site/steveyegge2/effective-emacs
(global-set-key (kbd "C-x C-m") #'execute-extended-command)
(global-set-key (kbd "C-w")     #'backward-kill-word)
(global-set-key (kbd "C-x C-k") #'kill-region) ; since C-w no longer does
(global-set-key (kbd "M-o")     #'other-window)

;; Make it easier to discover key shortcuts
(use-package which-key
  :ensure nil
  :custom
  (which-key-idle-delay 0.1)
  :config
  (which-key-mode 1))

;; Move buffers to adjacent windows
(use-package buffer-move
  :bind (("<C-S-up>"    . buf-move-up)
         ("<C-S-down>"  . buf-move-down)
         ("<C-S-left>"  . buf-move-left)
         ("<C-S-right>" . buf-move-right)))

;;; Applications
(use-package magit
  :bind (("C-x g"   . magit-status)
         ("C-x M-g" . magit-dispatch)))

(use-package bbdb
  :defer t)

;; Gnus: render HTML mail with w3m; read Hacker News as a newsgroup
(use-package w3m
  :defer t
  :init
  (setq mm-text-html-renderer 'w3m
        w3m-fill-column 100))
(use-package nnhackernews
  :defer t)

;; ePub reader https://depp.brause.cc/nov.el/
(use-package nov
  :mode ("\\.epub\\'" . nov-mode))

;;; init.el ends here
